# Copia este archivo a .env y cambia los valores. .env NO se sube al repositorio.

# --- Base de datos (PostgreSQL) ---
POSTGRES_DB=yupana
POSTGRES_USER=yupana
POSTGRES_PASSWORD=cambia-esta-clave-larga

# --- Aplicación ---
# Clave inicial del usuario estudio (mínimo 12 caracteres; la de demostración está prohibida)
YUPANA_SEED_CLAVE=cambia-esta-clave-de-demo

# --- HTTPS (perfil "https" de docker compose) ---
# Dominio público que apunta a este servidor. Con localhost, Caddy usa un certificado local.
YUPANA_DOMINIO=localhost
# Sin HTTPS (solo local): la cookie de sesión no puede ser Secure ni enviarse HSTS
YUPANA_COOKIE_SECURE=false
YUPANA_HSTS=false
# Con HTTPS real, déjalos en true:
# YUPANA_COOKIE_SECURE=true
# YUPANA_HSTS=true
